<?xml version="1.0" ?>
<!--
  볼트를 담는 열린 상자("통") — 그리퍼가 안으로 들어가 여러 볼트를 하나씩
  집을 수 있도록 '얕고 넓은' 트레이형. 외형 0.24 x 0.20 x 0.025 (L×W×H),
  벽/바닥 두께 5mm. 내부 공동 ≈ 0.23 x 0.19 x 0.020 깊이.

  설계 근거: 열린 Franka 그리퍼 총폭 ≈100mm. 통 안 '무더기'에서 볼트를 하나씩
  집으려면 파지 지점 주변으로 손가락(±50mm)이 벽·옆 볼트에 안 닿을 여유가
  필요하다. 내부를 0.23×0.19 로 넓히고 벽 높이는 20mm 로 낮춰, 손가락이 통
  안으로 들어갈 수 있게 한다. (같은 모델을 놓는 통으로도 재사용)
  원점은 바닥면 하부 중심(z=0이 바닥). 정적(static).

  ⚠ 치수/포즈는 robot_arm_tutorials/bolt_scene.py 의 BIN_* 상수와 짝을 이룸.
-->
<sdf version="1.8">
  <model name="bolt_bin">
    <static>true</static>
    <link name="bin">
      <!-- 바닥: 0.24 x 0.20 x 0.005, 중심 z=0.0025 -->
      <collision name="floor_collision">
        <pose>0 0 0.0025 0 0 0</pose>
        <geometry>
          <box><size>0.24 0.20 0.005</size></box>
        </geometry>
      </collision>
      <visual name="floor_visual">
        <pose>0 0 0.0025 0 0 0</pose>
        <geometry>
          <box><size>0.24 0.20 0.005</size></box>
        </geometry>
        <material>
          <ambient>0.25 0.20 0.15 1</ambient>
          <diffuse>0.40 0.32 0.22 1</diffuse>
        </material>
      </visual>

      <!-- +X 벽: 두께 0.005, 높이 0.020, 중심 x=0.1175 z=0.015 -->
      <collision name="wall_px_collision">
        <pose>0.1175 0 0.015 0 0 0</pose>
        <geometry>
          <box><size>0.005 0.20 0.020</size></box>
        </geometry>
      </collision>
      <visual name="wall_px_visual">
        <pose>0.1175 0 0.015 0 0 0</pose>
        <geometry>
          <box><size>0.005 0.20 0.020</size></box>
        </geometry>
        <material>
          <ambient>0.25 0.20 0.15 1</ambient>
          <diffuse>0.40 0.32 0.22 1</diffuse>
        </material>
      </visual>

      <!-- -X 벽 -->
      <collision name="wall_nx_collision">
        <pose>-0.1175 0 0.015 0 0 0</pose>
        <geometry>
          <box><size>0.005 0.20 0.020</size></box>
        </geometry>
      </collision>
      <visual name="wall_nx_visual">
        <pose>-0.1175 0 0.015 0 0 0</pose>
        <geometry>
          <box><size>0.005 0.20 0.020</size></box>
        </geometry>
        <material>
          <ambient>0.25 0.20 0.15 1</ambient>
          <diffuse>0.40 0.32 0.22 1</diffuse>
        </material>
      </visual>

      <!-- +Y 벽: 0.24 x 0.005 x 0.020, 중심 y=0.0975 z=0.015 -->
      <collision name="wall_py_collision">
        <pose>0 0.0975 0.015 0 0 0</pose>
        <geometry>
          <box><size>0.24 0.005 0.020</size></box>
        </geometry>
      </collision>
      <visual name="wall_py_visual">
        <pose>0 0.0975 0.015 0 0 0</pose>
        <geometry>
          <box><size>0.24 0.005 0.020</size></box>
        </geometry>
        <material>
          <ambient>0.25 0.20 0.15 1</ambient>
          <diffuse>0.40 0.32 0.22 1</diffuse>
        </material>
      </visual>

      <!-- -Y 벽 -->
      <collision name="wall_ny_collision">
        <pose>0 -0.0975 0.015 0 0 0</pose>
        <geometry>
          <box><size>0.24 0.005 0.020</size></box>
        </geometry>
      </collision>
      <visual name="wall_ny_visual">
        <pose>0 -0.0975 0.015 0 0 0</pose>
        <geometry>
          <box><size>0.24 0.005 0.020</size></box>
        </geometry>
        <material>
          <ambient>0.25 0.20 0.15 1</ambient>
          <diffuse>0.40 0.32 0.22 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
