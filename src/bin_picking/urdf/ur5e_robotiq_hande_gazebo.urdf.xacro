<?xml version="1.0"?>
<!--
  UR5e + Robotiq Hand-E 결합 모델 (Gazebo Sim / gz_ros2_control)

  이 파일은 **등록 입력물**이다. `ur5e_robotiq85_gazebo.urdf.xacro` 를 베이스로
  그리퍼만 Hand-E 로 갈아끼운 것이고, 파이프라인 코드는 이 파일을 전혀 모른다 —
  프로파일(`robot_profiles/data/ur5e_robotiq_hande.yaml`)이 여기를 가리킬 뿐이다.
  (왜 벤더 매크로를 자동 조립하지 못하는지는 2F-85 판 주석 참조)

  구성:
    world → ur_robot(UR5e) → tool0 → Hand-E IO 커플러(11mm) → Hand-E 본체
                                                            → grasp_tcp (파지 기준)

  [2F-85 판과 다른 점 ①] `ur_to_robotiq` 어댑터를 쓰지 않는다.
    2F-85 는 UR 플랜지↔Robotiq 사이의 물리 어댑터가 robotiq_description 쪽에
    따로 있어서 그걸 끼웠다. Hand-E 기술(記述)은 그 자리에 해당하는 **IO 커플러
    링크(`robotiq_hande_coupler`, +11.0mm)를 자기 매크로 안에 이미 갖고 있다**
    (robotiq_hande_gripper.xacro 의 `coupler_height` 0.011). 여기에 어댑터를 또
    끼우면 같은 부품이 둘이 된다.
    ⚠ 두 커플러가 같은 ISO 9409-1-50-4-M6 계열이라는 것은 도면상 판단이다.
      **Gazebo 에 실제로 띄워 메시 간섭/오프셋을 눈으로 확인하기 전까지는 확정
      사실이 아니다.**

  [2F-85 판과 다른 점 ②] 하드웨어 인터페이스 플러그인 이름.
    2F-85 xacro 는 `ign_ros2_control/IgnitionSystem`(하위호환 별칭)을 내보내지만,
    이 저장소가 새로 쓴 Hand-E 의 sim 분기는 팔 쪽과 같은 정식 이름
    `gz_ros2_control/GazeboSimSystem` 을 쓴다.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="$(arg name)">

  <xacro:arg name="name" default="ur5e_robotiq_hande"/>
  <xacro:arg name="ur_type" default="ur5e"/>
  <xacro:arg name="tf_prefix" default=""/>

  <!-- gz_ros2_control 이 읽을 컨트롤러 설정 -->
  <xacro:arg name="simulation_controllers"
             default="$(find bin_picking)/config/ur5e_hande_controllers.yaml"/>

  <!-- 파지 기준(TCP) 프레임을 `robotiq_hande_link` 에서 얼마나 띄울지.
       [유도] 파이프라인 규약상 TCP 는 손끝이 아니라 **파지 패드의 정중앙**이다
       (geometry._grasp_z_for: "패드가 샤프트를 대칭으로 감싸려면 TCP 를 볼트
       중심에 두는 게 이상적"). 그 지점을 벤더 메시에서 직접 잰다:

         finger_collision.dae 를 파싱하면 손가락 콜리전은 정확히 박스 2개다
         (정점 16개, unit meter=1.0, Z_UP, 노드 변환 없음 — 정점이 곧 링크 좌표):
           geometry0 (파지 패드) : x[0, 6.5]  y[-10.6, 10.5] z[26.55, 47.55] mm
           geometry1 (캐리지)    : x[4, 11]   y[-10.7, 10.5] z[ 6.00, 26.55] mm
         패드 중앙 z = (26.55 + 47.55)/2 = 37.05mm  (손가락 링크 기준)
         손가락 관절 원점은 `robotiq_hande_link` 기준 z = 99.0mm 이고 관절은
         x 축 슬라이더라 z 를 바꾸지 않는다 → 개구와 무관하게 일정하다.
           grasp_tcp_z = 99.0 + 37.05 = 136.05mm

       ※ 벤더가 준 `robotiq_hande_end`(z = 99.0 + 46.5 = 145.5mm)는 패드 중앙이
         아니라 손끝(콜리전 팁 47.55mm)에 거의 붙어 있다. 그대로 쓰면 이 저장소의
         TCP 규약과 어긋나므로 쓰지 않고 grasp_tcp 를 따로 만든다. -->
  <xacro:arg name="grasp_tcp_z" default="0.13605"/>

  <xacro:arg name="joint_limit_params"
             default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params"
             default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params"
             default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params"
             default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find ur_simulation_gz)/urdf/ur_gz.ros2_control.xacro"/>
  <xacro:include filename="$(find robotiq_hande_description)/urdf/robotiq_hande_gripper.xacro"/>

  <link name="world"/>

  <!-- ================== 팔 ================== -->
  <xacro:ur_robot
    name="$(arg name)"
    tf_prefix="$(arg tf_prefix)"
    parent="world"
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"
    safety_limits="false"
    force_abs_paths="true">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <xacro:ur_ros2_control name="$(arg name)" tf_prefix="$(arg tf_prefix)"/>

  <!-- ================== 그리퍼 ================== -->
  <xacro:robotiq_hande_gripper
    name="RobotiqHandeHardwareInterface"
    prefix="$(arg tf_prefix)"
    parent="$(arg tf_prefix)tool0"
    sim_ignition="true"
    use_fake_hardware="false"/>

  <!-- ================== 파지 기준 프레임 ==================
    파이프라인은 END_EFFECTOR_LINK 를 '파지 패드 중앙'으로 다룬다(FR3 의
    fr3_hand_tcp 와 같은 역할). 위 grasp_tcp_z 주석이 유도 근거다.
    ⚠ visual/collision 없는 순수 프레임 — MoveIt 이 이걸 충돌체로 잡으면
      통 위 자세가 전부 막힌다.                                            -->
  <link name="$(arg tf_prefix)grasp_tcp"/>
  <joint name="$(arg tf_prefix)grasp_tcp_joint" type="fixed">
    <parent link="$(arg tf_prefix)robotiq_hande_link"/>
    <child link="$(arg tf_prefix)grasp_tcp"/>
    <origin xyz="0 0 $(arg grasp_tcp_z)" rpy="0 0 0"/>
  </joint>

  <!-- ================== gz_ros2_control ==================
    2F-85 판과 같은 자리다. 설치된 robotiq_description 의 2F-85 매크로에는
    `<gazebo>` 블록이 아예 없고(grep 확인), 플러그인은 이렇게 결합 xacro 쪽에서
    한 번만 선언한다 — 팔·그리퍼가 같은 controller_manager 를 공유해야 하므로
    로봇당 하나여야 한다.                                                   -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg simulation_controllers)</parameters>
    </plugin>
  </gazebo>

</robot>
