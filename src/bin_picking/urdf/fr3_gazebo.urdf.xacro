<?xml version="1.0"?>
<!--
  Wrapper that includes franka_description/robots/fr3/fr3.urdf.xacro
  WITHOUT modifying the upstream file. Adds Gazebo-only adjustments
  needed for a standalone simulation:

  - Disable gravity on FR3 arm/hand/finger links. The default
    joint_trajectory_controller (effort + PID) does not implement
    explicit gravity compensation; without this override the arm would
    droop on the later joints. Mirrors franka_gazebo_bringup's
    gravity_overrides.xacro (no link names changed).

  Pass-through xacro arguments are forwarded by the launch file:
    hand:=true ee_id:=franka_hand ros2_control:=true
    gazebo:=true gazebo_effort:=true
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fr3">

  <xacro:include filename="$(find franka_description)/robots/fr3/fr3.urdf.xacro"/>

  <gazebo reference="fr3_link0"><gravity>false</gravity></gazebo>
  <gazebo reference="fr3_link1"><gravity>false</gravity></gazebo>
  <gazebo reference="fr3_link2"><gravity>false</gravity></gazebo>
  <gazebo reference="fr3_link3"><gravity>false</gravity></gazebo>
  <gazebo reference="fr3_link4"><gravity>false</gravity></gazebo>
  <gazebo reference="fr3_link5"><gravity>false</gravity></gazebo>
  <gazebo reference="fr3_link6"><gravity>false</gravity></gazebo>
  <gazebo reference="fr3_link7"><gravity>false</gravity></gazebo>
  <gazebo reference="fr3_link8"><gravity>false</gravity></gazebo>
  <gazebo reference="fr3_hand"><gravity>false</gravity></gazebo>
  <gazebo reference="fr3_leftfinger"><gravity>false</gravity></gazebo>
  <gazebo reference="fr3_rightfinger"><gravity>false</gravity></gazebo>

  <!-- ================= 빈피킹 비전 카메라 (eye-to-hand) =================
    집는 통(base 기준 x=0.40, z=0) 위 0.60m 에 RGB-D 카메라를 base(fr3_link0)에
    고정한다. 아래를 내려다보며 통 안 볼트를 스캔한다. base 에 고정이라 카메라↔
    base TF 가 robot_state_publisher 로 자동 발행되어, perception 노드가 tf2 로
    포인트클라우드를 base 프레임으로 변환할 수 있다.
    ⚠ Gazebo Harmonic 의 optical_frame_id 는 포인트클라우드 좌표계를 실제로
      회전시키지 않고 헤더 frame_id 만 바꿔 TF 불일치를 일으킨다. 데이터가
      camera_link 좌표(x-forward)로 나오므로 frame_id 도 camera_link 여야 맞다.
      camera_optical_link 프레임은 다른 소비자용으로 TF 트리에 남겨 둔다.     -->
  <!-- ⚠ visual/collision 없는 '순수 프레임' — MoveIt 이 카메라 박스를 충돌체로
       잡아 통 위 팔 자세(롤아웃)를 전부 막던 문제를 없앤다. gz rgbd_camera 센서는
       geometry 없이 링크에 붙어도 정상 동작한다. inertial 은 gz 링크 유효성용 최소값. -->
  <link name="camera_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <!-- +x(gz 카메라 시선축)를 아래(-z)로: pitch +90° -->
  <joint name="camera_joint" type="fixed">
    <parent link="fr3_link0"/>
    <child link="camera_link"/>
    <origin xyz="0.40 0.0 0.60" rpy="0 1.5708 0"/>
  </joint>
  <!-- ROS 광학 프레임(z-forward, x-right, y-down) -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="bin_camera" type="rgbd_camera">
      <camera>
        <horizontal_fov>1.05</horizontal_fov>       <!-- ~60°, 0.6m 에서 통 커버 -->
        <image><width>640</width><height>480</height></image>
        <clip><near>0.1</near><far>2.0</far></clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <topic>bin_camera</topic>
      <gz_frame_id>camera_link</gz_frame_id>
    </sensor>
  </gazebo>

</robot>
